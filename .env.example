# Leave AI_API_KEY/AI_BASE_URL unset to use the built-in default: a public, unauthenticated
# proxy (supabase/functions/ai-proxy) fronting a free OpenRouter model. Works with no setup.
AI_MODEL=z-ai/glm-5.2:free
# Any OpenRouter :free-suffixed model works — see https://openrouter.ai/models?max_price=0

# Alternate: bring your own OpenRouter (or OpenAI-compatible) key instead of the shared proxy.
# AI_API_KEY=sk-or-v1-...
# AI_BASE_URL=https://openrouter.ai/api/v1

# Alternate: route through Vercel AI Gateway instead of holding a provider key per user.
# Same OpenAI-compatible shape, just swap the two vars above:
# AI_API_KEY=<Vercel AI Gateway API key>
# AI_BASE_URL=https://ai-gateway.vercel.sh/v1
# AI_MODEL=anthropic/claude-sonnet-4.5   # gateway "provider/model" id

# Optional overrides
# AI_MAX_CONTEXT_TOKENS=100000
# ROFIANT_GITHUB_REPO=RofiantAI/Rofiant-Code
# ROFIANT_WEB_URL=https://app.rofiant.ca
